    "@types/log4js": "^2.3.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
