    "express": "^4.17.3",
    "express-rate-limit": "8.7.0",
    "express-validator": "^6.14.0",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "h3": "1.15.11",
    "inversify": "^6.0.1",
    "ipaddr.js": "1.9.1",
    "jsdom": "^19.0.0",
    "lodash.clonedeep": "^4.5.0",
    "log4js": "^6.4.5",
    "module-alias": "^2.2.2",
    "nuxt": "4.6.0",
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "pinia": "4.0.3",
    "reflect-metadata": "0.2.2",
